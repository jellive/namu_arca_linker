{
  "name": "namu_arca_linker",
  "version": "1.6.0",
  "description": "나무위키 실시간 검색어 옆에 아카라이브 링크를 자동으로 추가해주는 Chrome Extension입니다.",
  "main": "content.js",
  "scripts": {
    "build": "BUILD_ONE=content vite build && BUILD_ONE=popup vite build && BUILD_ONE=options vite build && BUILD_ONE=sidepanel vite build && BUILD_ONE=background vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "release": "npm run test:run && npm run lint && npm run build && node scripts/build-release.mjs",
    "deploy:upload": "dotenv -e .env -- chrome-webstore-upload upload --source release/namu_arca_linker-v$npm_package_version.zip",
    "deploy:publish": "dotenv -e .env -- chrome-webstore-upload publish",
    "deploy:status": "dotenv -e .env -- node scripts/check-cws.mjs",
    "deploy": "npm run release && npm run deploy:upload && npm run deploy:publish",
    "test:mutation": "stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jellive/namu_arca_linker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jellive/namu_arca_linker/issues"
  },
  "homepage": "https://github.com/jellive/namu_arca_linker#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/chrome": "^0.1.40",
    "@vitest/coverage-v8": "^4.1.5",
    "chrome-webstore-upload-cli": "^3.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.3",
    "terser": "^5.46.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "fast-uri": ">=3.1.2",
    "esbuild": ">=0.28.1",
    "undici": ">=7.29.0 <8"
  }
}
