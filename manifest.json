{
  "manifest_version": 3,
  "name": "나무위키 실검 아카라이브 링커",
  "version": "1.1.0",
  "description": "나무위키 실시간 검색어 옆에 아카라이브 링크를 추가하고, 검색어 변경을 자동 추적합니다",
  "host_permissions": [
    "https://namu.wiki/*",
    "https://arca.live/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://namu.wiki/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
